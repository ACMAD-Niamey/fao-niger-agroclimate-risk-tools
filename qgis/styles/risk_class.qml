<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis version="3.28" styleCategories="Symbology">
  <pipe>
    <rasterrenderer type="paletted" band="1" alphaBand="-1" nodataColor="">
      <colorPalette>
        <paletteEntry value="1" label="Low (&lt; 1.0)" color="#ffffb2" alpha="255"/>
        <paletteEntry value="2" label="Moderate (1.0 to &lt; 1.7)" color="#fecc5c" alpha="255"/>
        <paletteEntry value="3" label="High (1.7 to &lt; 2.4)" color="#fd8d3c" alpha="255"/>
        <paletteEntry value="4" label="Very high (&gt;= 2.4)" color="#e31a1c" alpha="255"/>
      </colorPalette>
    </rasterrenderer>
  </pipe>
</qgis>
